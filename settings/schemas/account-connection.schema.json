{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "account-connection",
  "version": "0.0.1",
  "displayName": "Account connection",
  "description": "OAuth client for the Account Management API (scopes account-uac-read, account-env-read). Write access to this schema defines the app's administrators.",
  "multiObject": false,
  "maxObjects": 1,
  "properties": {
    "accountUuid": {
      "displayName": "Account UUID",
      "type": "text",
      "nullable": false,
      "default": ""
    },
    "clientId": {
      "displayName": "OAuth client ID",
      "type": "text",
      "nullable": false,
      "default": ""
    },
    "clientSecret": {
      "displayName": "OAuth client secret",
      "type": "secret",
      "nullable": true
    }
  }
}
